# ==== THE MINT TOKEN FIELD ====
# ERC20 contract address used for mint payment.
# 100,000 tokens per mint, BURNT FOREVER at mint (1B supply / 10,000 mints).
# Leave empty at deploy time and plug it in later with ONE call:
#   cast send $CONTRACT_ADDRESS 'setMintToken(address)' <CA> --private-key $DEPLOYER_PRIVATE_KEY --rpc-url $RPC_URL
# Price auto-adjusts to the token's decimals. Settable exactly once, then locked.
MINT_TOKEN_CA=

# --- chain -----------------------------------------------------------
RPC_URL=
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ORACLE_PRIVATE_KEY=
ORACLE_ADDRESS=
CONTRACT_ADDRESS=        # filled in after deploy
MAX_SUPPLY=10000

# --- IBM Quantum -----------------------------------------------------
# free account: https://quantum.cloud.ibm.com  (Account settings -> API token)
IBM_QUANTUM_TOKEN=
# Measured examples on ibm_fez: 8192 shots used 4 QPU-seconds;
# 1024 shots used 2 QPU-seconds per batch job. Runtime varies by job/backend.
# Each NFT receives its predetermined shot; unused shots remain diagnostic data.
SHOTS=1024

# --- oracle daemon ---------------------------------------------------
POLL_MS=30000
MAX_SUBMIT_ATTEMPTS=8
# batch cadence: one quantum job per interval covers all pending mints
# (seal-first: assignments are fixed on-chain before the job is submitted)
# cost note: each batch job ~2 QPU-sec (~$3.20 pay-go); 10k mint-out = >= 20 jobs,
# more if batches run part-full - do not assume the 10-min/month free tier suffices
BATCH_INTERVAL_MS=1800000
MAX_BATCH=500
RESYNC_TICKS=50
# public provenance archive (canonical results JSON per job; publish this dir)
ARCHIVE_DIR=./archive
# public base URI where archive files are hosted (IPFS dir, GitHub raw, ...) -
# stored ON-CHAIN per batch at resolve as the archive discovery pointer;
# owner can repoint later via updateArchivePointer (hash stays the identity)
ARCHIVE_URI_BASE=https://raw.githubusercontent.com/quantumcoinputer/quantum-cats/master/archive/
# Publish each resolved archive as a separate GitHub commit before reveal.
# Authenticate GitHub CLI on the oracle host with repository contents-write access.
ARCHIVE_GITHUB_REPO=quantumcoinputer/quantum-cats
ARCHIVE_GITHUB_BRANCH=master
ARCHIVE_GITHUB_PUBLISH=1

# Private reviewer invitation worker on the host (never copy into frontend env).
# Uses IBM_QUANTUM_TOKEN above and the pinned instance-scoped Reader group.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
